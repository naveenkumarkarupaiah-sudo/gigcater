generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AGENT
  WORKER
  ADMIN
}

enum EventStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  APPROVED
  REJECTED
  COMPLETED
  PAID
}

enum PaymentStatus {
  PENDING
  PAID
}

enum ComplaintStatus {
  PENDING
  RESOLVED_GENUINE
  RESOLVED_INVALID
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile?
  agentProfile  AgentProfile?
  eventsCreated Event[]        @relation("AgentEvents")
  applications  Application[]  @relation("WorkerApplications")

  @@map("users")
}

model WorkerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  age             Int
  contactPhone    String
  profilePhotoKey String?
  idProofKey      String?
  gpayNumber      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("worker_profiles")
}

model AgentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  photos             String?
  whatsappNumber     String
  originalProofDoc   String?
  verificationStatus String   @default("VERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("agent_profiles")
}

model Event {
  id            String      @id @default(uuid())
  agentId       String
  agent         User        @relation("AgentEvents", fields: [agentId], references: [id], onDelete: Cascade)
  title         String
  category      String?
  description   String?
  location      String
  date          DateTime
  startTime     String
  endTime       String
  workersNeeded Int
  payPerWorker  Decimal     @db.Decimal(10, 2)
  status        EventStatus @default(OPEN)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  applications Application[]

  @@map("events")
}

model Application {
  id                  String            @id @default(uuid())
  eventId             String
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workerId            String
  worker              User              @relation("WorkerApplications", fields: [workerId], references: [id], onDelete: Cascade)
  status              ApplicationStatus @default(APPLIED)
  groupSize           Int               @default(1)
  additionalWorkers   String?
  rating              Int?
  attendanceConfirmed Boolean           @default(false)
  
  // Geotagged Check-In Logs
  checkInPhoto        String?
  checkInLat          Float?
  checkInLng          Float?
  checkInTime         DateTime?

  // Geotagged Check-Out Logs
  checkOutPhoto       String?
  checkOutLat         Float?
  checkOutLng         Float?
  checkOutTime        DateTime?

  // Payment Lifecycle — starts once the worker uploads the Out-Time (check-out) photo
  paymentStatus       PaymentStatus?
  paymentDueAt        DateTime?
  paymentPaidAt       DateTime?
  paymentReference    String?
  paymentProofKey     String?

  complaints          Complaint[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([eventId, workerId])
  @@map("applications")
}

model Complaint {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workerId      String
  agentId       String
  reason        String
  status        ComplaintStatus @default(PENDING)
  adminNotes    String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("complaints")
}
